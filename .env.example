# --- 공통 ---
PORT=8080

# --- Postgres ---
DATABASE_URL=postgres://reclassic:reclassic@localhost:5432/reclassic?sslmode=disable

# --- Cloudflare R2 (S3 호환) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reclassic-sources

# --- Gutenberg 수집 ---
# 요청에 실을 식별용 User-Agent. 연락 가능한 주소를 포함할 것
GUTENBERG_USER_AGENT=reclassic/0.1 (+https://example.com; contact@example.com)
# 요청 간 최소 간격(ms). 1000 미만으로 낮추지 말 것
GUTENBERG_MIN_INTERVAL_MS=1000

# --- 웹 (TanStack Start) ---
# 브라우저에서 쓰는 공개 API URL
VITE_API_URL=http://localhost:8080
# SSR에서 쓰는 내부 API 호스트 (Railway: api.railway.internal)
API_INTERNAL_HOST=localhost
API_PORT=8080
