# --- 공통 ---
PORT=8080

# --- Postgres ---
DATABASE_URL=postgres://reclassic:reclassic@localhost:5432/reclassic?sslmode=disable

# --- 오브젝트 스토리지 (S3 호환) ---
# 로컬은 docker compose의 MinIO. 프로덕션(R2)에서는 S3_ENDPOINT를 비우고
# R2_ACCOUNT_ID를 채운다 — 비어 있으면 R2 엔드포인트를 조립한다.
S3_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=reclassic
R2_SECRET_ACCESS_KEY=reclassic-secret
R2_BUCKET=reclassic-sources

# --- CORS ---
# 브라우저가 API를 직접 부를 수 있는 출처. 쉼표로 구분한다.
# 와일드카드는 쓰지 않는다 — credentials와 함께 쓸 수 없고, 써서도 안 된다.
# LAN에서 접속하려면 그 주소도 넣는다: http://192.168.x.x:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --- 공개 URL ---
# 사이트맵에 들어가는 절대 주소. 프로덕션은 실제 도메인이다.
PUBLIC_BASE_URL=http://localhost:3100

# --- 로그인 (Google OAuth) ---
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 만든 OAuth 2.0 클라이언트.
# 승인된 리디렉션 URI에 GOOGLE_REDIRECT_URL 값을 그대로 등록해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# 로그인 후 브라우저를 보낼 웹 주소.
LOGIN_SUCCESS_REDIRECT=http://localhost:3100/
# 이 Google 계정으로 로그인하면 admin이 된다. 마스터 계정이다.
ADMIN_EMAIL=

# --- 세션 쿠키 ---
# 프로덕션(https)에서는 반드시 true. 로컬 http에서는 false여야 쿠키가 붙는다.
COOKIE_SECURE=false
# 웹과 API가 다른 서브도메인일 때 상위 도메인을 넣는다 (예: .reclassic.example).
COOKIE_DOMAIN=

# --- Gutenberg 수집 ---
# 요청에 실을 식별용 User-Agent. 연락 가능한 주소를 포함할 것
GUTENBERG_USER_AGENT=reclassic/0.1 (+https://example.com; contact@example.com)
# 요청 간 최소 간격(ms). 1000 미만으로 낮추지 말 것
GUTENBERG_MIN_INTERVAL_MS=1000

# --- 웹 (TanStack Start) ---
# VITE_ 둘은 런타임 값이 아니다. Vite가 빌드 시점에 클라이언트 번들에 박는다 (ADR-032).
# 프로덕션에서는 이 값이 바뀌면 재시작이 아니라 재빌드다.
# 브라우저에서 쓰는 공개 API URL
VITE_API_URL=http://localhost:8080
# 로그인 시작 주소. 브라우저가 직접 이동하므로 공개 API 주소여야 한다.
VITE_LOGIN_URL=http://localhost:8080/auth/google/start
# SSR에서 쓰는 내부 API 호스트 (Railway: api.railway.internal)
API_INTERNAL_HOST=localhost
API_PORT=8080
